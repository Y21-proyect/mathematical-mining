def carta_astros():
    global astros
    astro=0
    indice=0
    mascara=0
    mascaraN=0b1111111100000000000000000000000000000000000000000000000000000000
    mascaraO=0b1000000010000000100000001000000010000000100000001000000010000000
    mascaraE=0b0000000100000001000000010000000100000001000000010000000100000001
    mascara_aux=0b0
    mascara1=1
    mascara2=0

    carrera=False

    print('\n\n--- Opening chart of astros')
    print('-- Loading chart of astros')
    with open('carta constelaciones.txt','r',encoding='utf-8') as carta:

        for a in carta:
            indice+=1

        print('- Found',indice,'astros')

        astros= np.zeros((8,indice), dtype=np.uint64)

        indice=0
        a=''

        carta.seek(0)

        for a in carta:

            mascara_aux=0
            mascara1=0
            mascara2=0
          
            astro=int(a,2)

            astros[0][indice]=indice

            astros[1][indice]=astro

            astros[2][indice]=astro.bit_count()

            astros[3][indice]=mascara_aux=(mascaraN & astro)>>55

            astros[3][indice]= astros[3][indice] | ((mascara_aux>>7)<<21)

            astros[3][indice]= astros[3][indice] | ((mascara_aux & 1)<<20)
   
            mascara_aux=mascaraO & astro
            for b in [63,56,55,49,47,42,39,35,31,28,23,21,15,14,7,7]:
                if carrera==False:
                    mascara1=1 << b
                    mascara1=mascara1 & mascara_aux
                    carrera=True
                else:
                    mascara1>>=b
                    mascara2=mascara2 | mascara1
                    carrera=False

            mascara2<<=10
            astros[3][indice]= astros[3][indice] | mascara2


            mascara_aux=mascaraE & astro
            for b in [56,49,48,42,40,35,32,28,24,21,16,14,8,7,0,0]:                     
                if carrera==False:
                    mascara1=1 << b
                    mascara1=mascara1 & mascara_aux
                    carrera=True
                else:
                    mascara1>>=b
                    astros[4][indice]=astros[4][indice] | mascara1
                    carrera=False

            astros[4][indice]<<=10
            astros[5][indice]= (0b1 & astro)<<24
            astros[6][indice]= 0b11111111 & astro
           
            astros[7][indice]= ((0b10000000 & astro)>>7)<<23

            indice+=1
      
        print('- Loaded ',indice,'astros')
        print('- Last value loaded')
        print(bin(astros[1][indice-1]))



